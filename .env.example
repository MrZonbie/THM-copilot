# The AI Provider to use ('openai' or 'gemini')
AI_PROVIDER=openai

# Your API Key based on the provider
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the default model names ('gpt-4o' or 'gemini-1.5-pro')
# MODEL_NAME=

# Port for the backend proxy server
PORT=3001
